# =========================================================================
# Node.js & Backend Git Ignore Rules
# =========================================================================

# Dependencies
node_modules/
package-lock.json.backup
jspm_packages/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
serviceAccountKey.json
sendgrid.env

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log
firebase-debug.*.log
firestore-debug.log

# Testing & coverage
coverage/
.nyc_output/

# Runtime data & temp files
pids/
*.pid
*.seed
*.pid.lock
.temp/
temp_*.bat
data/*.sqlite*
data/*.db*

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db
