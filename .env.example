# Environment
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# Resend Email Configuration (For Live Email Delivery to Inboxes)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Rivava TrackFi <support@rivava.in>

# Firebase Configuration (Primary Database & Auth)
# Option 1: Full JSON string in environment variable (Recommended for Render / Cloud)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"rivava-signin",...}

# Option 2: Local file path
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=rivava-signin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_OTP_WINDOW_MS=60000
RATE_LIMIT_OTP_MAX_REQUESTS=5

# Razorpay Payment Gateway Configuration
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
